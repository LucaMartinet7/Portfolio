{
    "name": "lucamartinet-portfolio",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "predev": "node scripts/fetch-contributions.js --if-missing",
        "dev": "vite",
        "prebuild": "node scripts/fetch-contributions.js",
        "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.js",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm run build"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.10.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1"
    }
}
